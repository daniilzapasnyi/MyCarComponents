"Reproducible MapEngineFuelCutDyno experiment; see the lecture report for validation status."
analysis MapEngineFuelCutDynoTransient
  extends TransientAnalysis(stop = 7, alg = ODEAlg.Rodas5P(), optimize = OptimizationLevel.None())
  parameter rpm::Real = 3080.0
  parameter pedal_initial::Real = 0.1034
  parameter pedal_final::Real = 0.12
  parameter p_m0::Pressure = 47829.1
  model = MapEngineFuelCutDyno(rpm = rpm, pedal_initial = pedal_initial, pedal_final = pedal_final, p_m0 = p_m0)
end
