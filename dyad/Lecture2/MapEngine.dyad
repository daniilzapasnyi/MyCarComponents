# Adapted from the official 16ESPD build guide / HandsOn02/MapEngine.dyad
# Reference: lecture-05-dyad-3.5. Student package implementation; see coursework/SOURCES.md.
component MapEngine
  "Pedal, 0 released to 1 floored"
  pedal = RealInput() {^pedal}
  "Vacuum take-off: the hose to the brake booster, at manifold pressure"
  vacuum = VehicleSystemsComponents.Vehicle.GasPort() {^vacuum}
  "Output shaft"
  spline = Spline() {^spline}
  "Engine mounts"
  support = Spline() {^support}
  "Manifold absolute pressure [Pa]"
  p_m = RealOutput() {^p_m}
  "Fuel mass flow [kg/s]"
  mdot_fuel = RealOutput() {^mdot_fuel}
  "CO2 mass flow [kg/s]"
  mdot_co2 = RealOutput() {^mdot_co2}
  air = AirPath() {^air}
  speed = RotationalComponents.Sensors.VelocitySensor() {^speed}
  torque_map = VehicleSystemsComponents.Vehicle.Engine.TorqueMap() {^torque_map}
  fuel_map = VehicleSystemsComponents.Vehicle.Engine.FuelMap() {^fuel_map}
  "CO2 per kilogram of petrol burned completely, 3.09 (textbook)"
  co2 = BlockComponents.Math.Gain(k = 3.09) {^co2}
  torque = RotationalComponents.Sources.TorqueSource() {^torque}
relations
  connect(pedal, air.u_thr) {^wire1}
  connect(vacuum, air.vacuum) {^wire2}
  connect(speed.w, air.omega) {^wire3}
  connect(speed.w, torque_map.omega) {^wire4}
  connect(speed.w, fuel_map.omega) {^wire5}
  connect(air.p_m, torque_map.p_m) {^wire6}
  connect(air.p_m, fuel_map.p_m) {^wire7}
  connect(air.p_m, p_m) {^wire8}
  connect(torque_map.y, torque.tau) {^wire9}
  connect(fuel_map.y, co2.u) {^wire10}
  connect(fuel_map.y, mdot_fuel) {^wire11}
  connect(co2.y, mdot_co2) {^wire12}
  connect(torque.spline, spline) {^wire13}
  connect(speed.spline, spline) {^wire14}
  connect(torque.support, support) {^wire15}
metadata {
  "Dyad": {"icons":{"default":"dyad://VehicleSystemsComponents/Vehicle/Engine/MappedEngine.svg"}},
  "_links": {
