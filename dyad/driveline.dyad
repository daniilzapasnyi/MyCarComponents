"Driveline model with gearbox and rolling wheel"
component Driveline
  spline = Spline() {^spline}
  support_r = Spline() {^support_r}
  flange = Flange() {^flange}
  support_t = Flange() {^support_t}
  gear = RotationalComponents.Components.IdealGear(ratio = i) {^gear}
  wheel = RotationalComponents.Components.IdealRollingWheel(radius = r) {^wheel}
  inertia = RotationalComponents.Components.Inertia(J = J_w) {^inertia}
  parameter i::Real = 4.0
  parameter r::Length = 0.31
  parameter J_w::MomentOfInertia = 2.0
relations
  connect(spline, gear.spline_a) {^id8}
  connect(gear.spline_b, inertia.spline_a) {^id9}
  connect(inertia.spline_b, wheel.spline) {^id10}
  connect(wheel.flange, flange) {^id11}
  connect(gear.support, support_r) {^id12}
  connect(wheel.support_r, support_r) {^id13}
  connect(wheel.support_t, support_t) {^id14}
metadata {
