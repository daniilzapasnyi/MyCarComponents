# Adapted from the official 16ESPD build guide / HandsOn/Car.dyad
# Reference: lecture-05-dyad-3.5. Student package implementation; see coursework/SOURCES.md.
component Car
  "Commanded engine torque"
  tau_cmd = RealInput() {^tau_cmd}
  "Vehicle speed in km/h"
  v_kmh = RealOutput() {^v_kmh}
  engine = MyCarComponents.Engine() {^engine}
  driveline = Driveline() {^driveline}
  body = MyCarComponents.Body() {^body}
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  to_kmh = BlockComponents.Math.Gain(k = 3.6) {^to_kmh}
  "Engine mounts and gearbox housing"
  rot_ground = RotationalComponents.Components.Fixed() {^rot_ground}
  "Road under the wheel"
  trans_ground = TranslationalComponents.Components.Fixed() {^trans_ground}
relations
  connect(tau_cmd, engine.tau_cmd) {^wire1}
  connect(engine.spline, driveline.spline) {^wire2}
  connect(engine.support, rot_ground.spline) {^wire3}
  connect(driveline.support_r, rot_ground.spline) {^wire4}
  connect(driveline.flange, body.flange) {^wire5}
  connect(driveline.support_t, trans_ground.flange) {^wire6}
  connect(vsensor.flange, body.flange) {^wire7}
  connect(vsensor.v, to_kmh.u) {^wire8}
  connect(to_kmh.y, v_kmh) {^wire9}
metadata {
  "Dyad": {"icons":{"default":"dyad://VehicleSystemsComponents/HandsOn/Car.svg"},"labels":[{"label":"$(instance)","x":500,"y":1100,"rot":0}]},
  "_links": {
    "tau_cmd": {"Dyad":{"placement":{"diagram":{"x1":-50,"x2":50,"y1":450,"y2":550}}}},
    "v_kmh": {"Dyad":{"placement":{"diagram":{"x1":950,"x2":1050,"y1":450,"y2":550}}}},
    "engine": {"Dyad":{"placement":{"diagram":{"x1":120,"x2":220,"y1":450,"y2":550}}}},
    "driveline": {"Dyad":{"placement":{"diagram":{"x1":320,"x2":420,"y1":450,"y2":550}}}},
    "body": {"Dyad":{"placement":{"diagram":{"x1":560,"x2":660,"y1":450,"y2":550}}}},
    "vsensor": {"Dyad":{"placement":{"diagram":{"x1":560,"x2":660,"y1":250,"y2":350}}}},
    "to_kmh": {"Dyad":{"placement":{"diagram":{"x1":760,"x2":860,"y1":250,"y2":350}}}},
    "rot_ground": {"Dyad":{"placement":{"diagram":{"x1":120,"x2":220,"y1":700,"y2":800}}}},
    "trans_ground": {"Dyad":{"placement":{"diagram":{"x1":331,"x2":431,"y1":800,"y2":900}}}},
    "wire1": {"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"path":{}}},
    "wire2": {"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"path":{}}},
    "wire3": {"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"path":{}}},
    "wire4": {"Dyad":{"edges":[{"S":1,"M":[{"x":358,"y":650},{"x":170,"y":650}],"E":2}],"path":{}}},
    "wire5": {"Dyad":{"edges":[{"S":1,"M":[{"x":480,"y":500},{"x":480,"y":400},{"x":700,"y":400},{"x":700,"y":500}],"E":2}],"path":{}}},
    "wire6": {"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"path":{}}},
    "wire7": {"Dyad":{"edges":[{"S":1,"M":[{"x":480,"y":300},{"x":480,"y":400}],"E":-1},{"S":-1,"M":[{"x":700,"y":400},{"x":700,"y":500}],"E":2}],"junctions":[{"x":480,"y":400}],"path":{}}},
    "wire8": {"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"path":{}}},
