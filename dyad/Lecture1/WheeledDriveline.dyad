    "wire5": {"Dyad":{"edges":[{"S":1,"M":[{"x":250,"y":900},{"x":380,"y":900}],"E":2}],"path":{}}},
    "wire6": {"Dyad":{"edges":[{"S":1,"M":[{"x":575,"y":650},{"x":380,"y":650}],"E":2}],"path":{}}},
