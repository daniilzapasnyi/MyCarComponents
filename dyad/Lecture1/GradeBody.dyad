# Adapted from the official 16ESPD build guide / HandsOn/GradeBody.dyad
# Reference: lecture-05-dyad-3.5. Student package implementation; see coursework/SOURCES.md.
component GradeBody
  "Tractive force from the driveline"
  flange = Flange() {^flange}
  "Road gradient, tan(alpha)"
  grade = RealInput() {^grade}
  mass = TranslationalComponents.Components.Mass(m = m) {^mass}
  drag = TranslationalComponents.Sources.QuadraticSpeedDependentForce(ForceDirection = false, v_nominal = v_nominal, f_nominal = -0.5 * rho * CdA * v_nominal ^ 2) {^drag}
  rolling = TranslationalComponents.Components.RollingResistance(fWeight = m * g) {^rolling}
  cr_const = BlockComponents.Sources.Constant(k = f_r) {^cr_const}
  gradeforce = GradeForce(m = m, g = g) {^gradeforce}
  ground = TranslationalComponents.Components.Fixed() {^ground}
  "Vehicle mass"
  parameter m::Dyad.Mass = 1400
  "Aerodynamic drag area, Cd * A"
  parameter CdA::Area = 0.63
  "Air density"
  parameter rho::Density = 1.2
  "Rolling resistance coefficient"
  parameter f_r::Real = 0.012
  "Gravitational acceleration"
  parameter g::Acceleration = 9.80665
  "Speed at which the drag force is specified"
  parameter v_nominal::Velocity = 30
relations
  connect(flange, mass.flange_a) {^wire1}
  connect(drag.flange, mass.flange_a) {^wire2}
  connect(rolling.flange, mass.flange_a) {^wire3}
  connect(gradeforce.flange, mass.flange_a) {^wire4}
  connect(drag.support, ground.flange) {^wire5}
  connect(rolling.support, ground.flange) {^wire6}
  connect(gradeforce.support, ground.flange) {^wire7}
  connect(cr_const.y, rolling.cr) {^wire8}
  connect(grade, rolling.inclination) {^wire9}
  connect(grade, gradeforce.grade) {^wire10}
metadata {
  "Dyad": {"icons":{"default":"dyad://VehicleSystemsComponents/HandsOn/GradeBody.svg"},"labels":[{"label":"$(instance)","x":500,"y":1100,"rot":0}]},
