# Adapted from official 16ESPD HandsOn/Body.dyad (TestBody).
# Reference: lecture-05-dyad-3.5; see coursework/SOURCES.md.
test component TestBody
  "Constant tractive force from rest"
  tractive = TranslationalComponents.Sources.ConstantForce(f_constant = 500) {^tractive}
  body = MyCarComponents.Body() {^body}
  fixed = TranslationalComponents.Components.Fixed() {^fixed}
relations
  connect(tractive.flange, body.flange) {^wire1}
  connect(tractive.support, fixed.flange) {^wire2}
  initial body.mass.s = 0
  initial body.mass.v = 0
metadata {
  "_links": {
    "tractive": {"Dyad":{"placement":{"diagram":{"x1":150,"x2":250,"y1":450,"y2":550}}}},
    "body": {"Dyad":{"placement":{"diagram":{"x1":450,"x2":550,"y1":450,"y2":550}}}},
    "fixed": {"Dyad":{"placement":{"diagram":{"x1":150,"x2":250,"y1":700,"y2":800}}}},
    "wire1": {"Dyad":{"edges":[{"S":1,"M":[{"x":300,"y":500},{"x":300,"y":620},{"x":600,"y":620},{"x":600,"y":500}],"E":2}],"path":{}}},
    "wire2": {"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"path":{}}}
  }
}
end
