# Adapted from official 16ESPD HandsOn/SlipWheel1D.dyad (TestSlipWheel1D).
# Reference: lecture-05-dyad-3.5; see coursework/SOURCES.md.
test component TestSlipWheel1D
  "Full engine torque after the 4:1 gear"
  torque = RotationalComponents.Sources.ConstantTorque(tau_constant = 600) {^torque}
  inertia = RotationalComponents.Components.Inertia(J = 1) {^inertia}
  wheel = SlipWheel1D() {^wheel}
  mass = TranslationalComponents.Components.Mass(m = 1400) {^mass}
  mu_src = BlockComponents.Sources.Constant(k = 0.2) {^mu_src}
  fixed_r = RotationalComponents.Components.Fixed() {^fixed_r}
relations
  connect(torque.spline, inertia.spline_a) {^wire1}
  connect(torque.support, fixed_r.spline) {^wire2}
  connect(inertia.spline_b, wheel.spline) {^wire3}
  connect(wheel.flange, mass.flange_a) {^wire4}
  connect(mu_src.y, wheel.mu_scale) {^wire5}
  initial inertia.phi = 0
  initial inertia.w = 0
  initial mass.s = 0
  initial mass.v = 0
metadata {
  "_links": {
    "torque": {"Dyad":{"placement":{"diagram":{"x1":50,"x2":150,"y1":450,"y2":550}}}},
    "inertia": {"Dyad":{"placement":{"diagram":{"x1":250,"x2":350,"y1":450,"y2":550}}}},
    "wheel": {"Dyad":{"placement":{"diagram":{"x1":450,"x2":550,"y1":450,"y2":550}}}},
    "mass": {"Dyad":{"placement":{"diagram":{"x1":650,"x2":750,"y1":450,"y2":550}}}},
    "mu_src": {"Dyad":{"placement":{"diagram":{"x1":350,"x2":450,"y1":200,"y2":300}}}},
    "fixed_r": {"Dyad":{"placement":{"diagram":{"x1":50,"x2":150,"y1":700,"y2":800}}}},
    "wire1": {"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"path":{}}},
    "wire2": {"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"path":{}}},
    "wire3": {"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"path":{}}},
    "wire4": {"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"path":{}}},
    "wire5": {"Dyad":{"edges":[{"S":1,"M":[{"x":501,"y":250}],"E":2}],"path":{}}}
  }
}
end
