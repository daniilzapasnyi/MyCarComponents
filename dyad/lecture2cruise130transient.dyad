
"Lecture 2 - Trial cruise at 130 km/h"

analysis Lecture2Cruise130Transient
  extends Dyad.TransientAnalysis(stop = 60)

  parameter speed_kmh::Real = 130
  parameter pedal_cmd::Real = 0.1742
  parameter rpm0::Real = 2182
  parameter p_m0::Pressure = 54420

  model = VehicleSystemsComponents.HandsOn02.MappedCarCruise(
    speed_kmh = speed_kmh,
    pedal_cmd = pedal_cmd,
    rpm0 = rpm0,
    p_m0 = p_m0
  )

relations
end
